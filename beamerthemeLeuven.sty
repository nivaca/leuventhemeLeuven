\mode<presentation>

\setbeamertemplate{navigation symbols}{}

\newif\ifbeamer@secheader
\beamer@secheaderfalse

\DeclareOptionBeamer{secheader}{\beamer@secheadertrue}
\ProcessOptionsBeamer

\usecolortheme{whale}
\usecolortheme{orchid}
\useoutertheme{infolines}

\setbeamertemplate{title page}[default][wd=\textwidth,colsep=0pt,rounded=true,shadow=false]


\ifbeamer@secheader\else\setbeamertemplate{headline}[default]\fi


\usefonttheme{structuresmallcapsserif}
\usefonttheme{serif}
\setbeamerfont{structure}{shape=\upshape, family=\rmfamily}
\setbeamerfont{title}{size=\Large, shape=\itshape, series=\mdseries, parent=structure}
\setbeamerfont{subtitle}{size=\normalsize, parent=title}
\setbeamerfont{author}{size=\normalsize, series=\mdseries, parent=structure}
\setbeamerfont{date}{size=\footnotesize, series=\mdseries, parent=structure}
\setbeamerfont{institute}{size=\footnotesize, series=\mdseries, parent=structure}
\setbeamerfont{section in toc}{size=\large, series=\bfseries, parent=structure}
\setbeamerfont{section in head/foot}{size=\tiny, parent=structure}
\setbeamerfont{subsection in toc}{size=\small, series=\mdseries, parent={section in toc}}
\setbeamerfont{frametitle}{size=\Large,  shape=\itshape,  series=\mdseries, parent=structure}
\setbeamerfont{framesubtitle}{parent=frametitle, size=\large}
\setbeamerfont{caption}{size=\footnotesize}
\setbeamerfont{item}{parent=structure, series=\mdseries}
\setbeamerfont{block title}{size=\large, series=\mdseries, parent={structure, block body}}



\setbeamertemplate{itemize item}{\scriptsize\raise1.25pt\hbox{\donotcoloroutermaths$\bullet$}}
\setbeamertemplate{itemize subitem}{\tiny\raise1.5pt\hbox{\donotcoloroutermaths$\bullet$}}
\setbeamertemplate{itemize subsubitem}{\tiny\raise1.5pt\hbox{\donotcoloroutermaths$\bullet$}}

\setbeamertemplate{enumerate items}[default]

\definecolor{bluenivaca}{HTML}{335EA8}

\setbeamercolor{structure}{bg=black, fg=bluenivaca}
\setbeamercolor{frametitle}{bg=bluenivaca, fg=white}
\setbeamercolor{title}{bg=bluenivaca, fg=white}

\setbeamercolor{normal text}{fg=black, bg=white}

\setbeamercolor*{palette primary}{use=structure, fg=white, bg=structure.fg}
\setbeamercolor*{palette secondary}{use=structure, fg=white, bg=structure.fg}
\setbeamercolor*{palette tertiary}{use=structure, fg=white, bg=structure.fg}
\setbeamercolor*{palette quaternary}{use=structure, fg=white, bg=structure.fg}

\beamerdefaultoverlayspecification{<+->}

\mode
<all>
